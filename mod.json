{
    "geode": "5.9.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "xe1a.list_randomizer",
    "name": "List Randomizer",
    "version": "v1.0.0",
    "developer": "xander1111",
    "description": "Adds a wheel that can be spun to pick a random level from any ingame list",
    "dependencies": {
        "alphalaneous.alphas-ui-pack": {
            "version": ">=1.3.0",
            "required": true
        },
        "cvolton.level-id-api": {
            "version": ">=2.0.0",
            "required": true
        }
    },
    "settings": {
        "initial-spinning": {
            "type": "bool",
            "name": "Enable Initial Spinning",
            "description": "Enables or disables the initial spinning animation when first viewing the wheel page",
            "default": true
        }
    },
    "resources": {
        "files": [
            "resources/audio/*.ogg"
        ]
    },
    "links": {
        "source": "https://github.com/xander1111/gd-list-randomizer"
    }
}
